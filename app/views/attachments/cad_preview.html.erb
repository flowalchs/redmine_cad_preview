<%= render :layout => 'layouts/file' do %>
  <%= render :partial => 'cad_previews/viewer',
             :locals => {:attachment => @attachment, :cad_format => @cad_format, :cad_image => @cad_image,
                         :snapshot => @cad_snapshot, :view => nil, :embedded => false, :height => nil} %>
<% end %>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'cad_preview', :plugin => 'redmine_cad_preview' %>
  <%= javascript_include_tag 'cad_preview', :plugin => 'redmine_cad_preview', :type => 'module' %>
<% end %>
